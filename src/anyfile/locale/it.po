#: src/anyfile/app.py:28 src/anyfile/cli.py:105
#, python-brace-format
msgid "anyfile: history not available: {error}"
msgstr "anyfile: cronologia non disponibile: {error}"

#: src/anyfile/app.py:46
msgid "started from the Dolphin context menu"
msgstr "avviato dal menu contestuale di Dolphin"

#: src/anyfile/app.py:48
msgid "show the radial menu under the pointer instead of the window"
msgstr "mostra il menu radiale sotto il puntatore invece della finestra"

#: src/anyfile/app.py:49
msgid "open the conversion history"
msgstr "apre la cronologia delle conversioni"

#: src/anyfile/app.py:57
msgid ""
"anyfile: PySide6 is not installed, so the graphical interface is not "
"available.\n"
"Use 'anyfile convert FILE -t FORMAT' or install PySide6."
msgstr ""
"anyfile: PySide6 non è installato; l'interfaccia grafica non è disponibile.\n"
"Usa 'anyfile convert FILE -t FORMATO' oppure installa PySide6."

#: src/anyfile/cli.py:28
msgid "ANYFILE — local file converter."
msgstr "ANYFILE — convertitore di file locale."

#: src/anyfile/cli.py:29
msgid "Without a command it opens the graphical interface: anyfile [FILE...]"
msgstr "Senza comandi apre l'interfaccia grafica: anyfile [FILE...]"

#: src/anyfile/cli.py:34
msgid "convert one or more files"
msgstr "converte uno o più file"

#: src/anyfile/cli.py:37
msgid ""
"target format (e.g. png, mp3, pdf); the file's own format compresses it "
"(e.g. photo.jpg -t jpg)"
msgstr ""
"formato di destinazione (es. png, mp3, pdf); lo stesso formato del file lo "
"comprime (es. foto.jpg -t jpg)"

#: src/anyfile/cli.py:40 src/anyfile/cli.py:55
msgid "destination folder (default: the folder of each file)"
msgstr "cartella di destinazione (predefinita: la cartella di ciascun file)"

#: src/anyfile/cli.py:41 src/anyfile/cli.py:56
msgid "overwrite existing files"
msgstr "sovrascrive i file già esistenti"

#: src/anyfile/cli.py:43
msgid ""
"max, balanced (default) or small; only applies to lossy formats (JPEG, WebP, "
"MP3, video...)"
msgstr ""
"max, balanced (predefinita) o small; vale solo per i formati con perdita "
"(JPEG, WebP, MP3, video...)"

#: src/anyfile/cli.py:46
msgid ""
"file holding the password of protected PDFs (“-”: standard input); without "
"it, the password is asked when needed"
msgstr ""
"file con la password dei PDF protetti («-»: standard input); senza, la "
"password viene chiesta quando serve"

#: src/anyfile/cli.py:49
msgid "edit one or more files: resize, rotate, remove audio..."
msgstr "modifica uno o più file: ridimensiona, ruota, togli l'audio..."

#: src/anyfile/cli.py:52
msgid "the edit to apply (see “anyfile info FILE” for those available)"
msgstr ""
"la modifica da applicare (vedi «anyfile info FILE» per quelle disponibili)"

#: src/anyfile/cli.py:53
msgid "the edit's option, e.g. 50 for resize (default: the usual one)"
msgstr ""
"l'opzione della modifica, es. 50 per resize (predefinita: quella abituale)"

#: src/anyfile/cli.py:58
msgid "max, balanced (default) or small, when the file has to be re-encoded"
msgstr "max, balanced (predefinita) o small, quando il file va ricodificato"

#: src/anyfile/cli.py:60
msgid ""
"file holding the password of protected PDFs, or the new one for “protect” "
"(“-”: standard input); without it, the password is asked"
msgstr ""
"file con la password dei PDF protetti, o quella nuova per «protect» («-»: "
"standard input); senza, la password viene chiesta"

#: src/anyfile/cli.py:63
msgid "show the detected format and the possible conversions"
msgstr "mostra il formato rilevato e le conversioni possibili"

#: src/anyfile/cli.py:66
msgid "show the installed conversion engines"
msgstr "mostra i motori di conversione installati"

#: src/anyfile/cli.py:68
msgid "show the conversion history"
