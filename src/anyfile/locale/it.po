msgid "started from the Dolphin context menu"
msgstr "avviato dal menu contestuale di Dolphin"

#: src/anyfile/app.py:48
msgid "show the radial menu under the pointer instead of the window"
msgstr "mostra il menu radiale sotto il puntatore invece della finestra"

#: src/anyfile/app.py:50
msgid "STRATUM: show the tracks inside the file and extract them"
msgstr "STRATUM: mostra le tracce contenute nel file e le estrae"

#: src/anyfile/app.py:51
