msgid ""
"anyfile: PySide6 is not installed, so the graphical interface is not "
"available.\n"
"Use 'anyfile convert FILE -t FORMAT' or install PySide6."
msgstr ""
"anyfile: PySide6 non è installato; l'interfaccia grafica non è disponibile.\n"
"Usa 'anyfile convert FILE -t FORMATO' oppure installa PySide6."

#: src/anyfile/cli.py:27
msgid "ANYFILE — local file converter."
msgstr "ANYFILE — convertitore di file locale."

#: src/anyfile/cli.py:28
msgid "Without a command it opens the graphical interface: anyfile [FILE...]"
msgstr "Senza comandi apre l'interfaccia grafica: anyfile [FILE...]"

#: src/anyfile/cli.py:33
msgid "convert one or more files"
msgstr "converte uno o più file"

#: src/anyfile/cli.py:36
msgid ""
"target format (e.g. png, mp3, pdf); the file's own format compresses it "
"(e.g. photo.jpg -t jpg)"
msgstr ""
"formato di destinazione (es. png, mp3, pdf); lo stesso formato del file lo "
"comprime (es. foto.jpg -t jpg)"

#: src/anyfile/cli.py:39
msgid "destination folder (default: the folder of each file)"
msgstr "cartella di destinazione (predefinita: la cartella di ciascun file)"

