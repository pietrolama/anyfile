msgid "overwrite existing files"
msgstr "sovrascrive i file già esistenti"

#: src/anyfile/cli.py:42
msgid ""
"max, balanced (default) or small; only applies to lossy formats (JPEG, WebP, "
"MP3, video...)"
msgstr ""
"max, balanced (predefinita) o small; vale solo per i formati con perdita "
"(JPEG, WebP, MP3, video...)"

#: src/anyfile/cli.py:45
msgid "show the detected format and the possible conversions"
msgstr "mostra il formato rilevato e le conversioni possibili"

#: src/anyfile/cli.py:48
msgid "show the installed conversion engines"
msgstr "mostra i motori di conversione installati"

#: src/anyfile/cli.py:50
msgid "show the conversion history"
msgstr "mostra la cronologia delle conversioni"

#: src/anyfile/cli.py:51
msgid "how many entries to show (default: 20)"
msgstr "quante voci mostrare (predefinito: 20)"

