[Desktop Entry]
Type=Application
Name=ANYFILE
GenericName=Convertitore di file
Comment=Converte immagini, audio, video e documenti
Exec=anyfile %F
Icon=document-export
Terminal=false
Categories=Utility;
Keywords=convert;converter;converti;formato;
Actions=cronologia;

[Desktop Action cronologia]
Name=Cronologia delle conversioni
Icon=view-history
Exec=anyfile --history
